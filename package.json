{
  "name": "oregon-compliance-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "check:production": "node scripts/check-production.mjs",
    "lint": "eslint",
    "test": "node --test tests/workspace.test.mjs tests/quickbooks.test.mjs tests/production-config.test.mjs tests/demo-operations.test.mjs tests/operations-fixture.test.mjs tests/interface-state.test.mjs && node tests/database.mjs && node tests/operations-database.mjs",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:rls": "psql \"$ADMIN_DATABASE_URL\" -v app_password=\"'$APP_DB_PASSWORD'\" -f prisma/rls.sql"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "2.117.3",
    "jose": "^6.2.12",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
