# Public connection details only. Never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep false until database, access, hosting, and healthcare requirements are verified.
NEXT_PUBLIC_CAREFLOW_LIVE_ENABLED=false
NEXT_PUBLIC_CAREFLOW_DATA_MODE=sample

# Optional Google browser integration. Restrict key to Picker API + approved referrers.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=
