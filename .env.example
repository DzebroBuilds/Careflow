# Copy to .env.local for Next.js and .env for Prisma/Docker.
# Never commit real secrets or real resident data.

# Postgres (docker-compose defaults — change for anything beyond local laptop use)
POSTGRES_USER=oct
POSTGRES_PASSWORD=oct_dev_only
POSTGRES_DB=oregon_compliance
DATABASE_URL=postgresql://oct:oct_dev_only@localhost:5432/oregon_compliance?schema=public

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Auth (placeholder — provider TBD; see docs/SCHEMA.md decisions)
# AUTH_SECRET=generate-with-openssl-rand-base64-32
# MFA_ISSUER=OregonComplianceTracker

# Provided by `npm run db:rls`
ADMIN_DATABASE_URL=postgresql://oct:oct_dev_only@localhost:5432/oregon_compliance
APP_DB_PASSWORD=careflow_app_dev_only
